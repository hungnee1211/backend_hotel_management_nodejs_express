# ---- Server ----
NODE_ENV=development
PORT=5000
# Reverse proxies in front of the app (needed for correct client IPs / rate limiting). 0 = none.
TRUST_PROXY=0
LOG_LEVEL=info

# ---- Database ----
# Transactions REQUIRE a replica set. `docker compose up -d` starts a single-node one (see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/hotel_management?replicaSet=rs0
# Development escape hatch ONLY: lets the app boot on a standalone mongod (booking/billing will not work).
ALLOW_STANDALONE_MONGO=false

# ---- Auth (used from Phase 3) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random strings stored hashed in MongoDB (no JWT refresh secret needed).
JWT_REFRESH_EXPIRES_IN=7d
# Secret pepper for hashing 6-digit OTPs (HMAC). Different from the JWT secret.
OTP_SECRET=
# Encrypts guest ID numbers at rest. Generate: openssl rand -hex 32. LOSING THIS KEY MAKES STORED ID NUMBERS UNREADABLE.
PII_ENCRYPTION_KEY=
OTP_EXPIRES_IN=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_MAX_RESENDS_PER_HOUR=5
BCRYPT_ROUNDS=12

# ---- Cookies / CORS ----
COOKIE_DOMAIN=
# Leave empty to default to true in production, false otherwise. Forced true when SAME_SITE=none.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax
# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:3000

# ---- Hotel defaults (used only to create the Settings document the first time) ----
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh
HOTEL_CURRENCY=VND

# ---- Optional integrations (later phases) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- First Admin bootstrap (`yarn create-admin`) ----
ADMIN_NAME=System Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
